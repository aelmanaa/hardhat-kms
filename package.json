{
  "name": "hardhat-kms-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "tsc -b",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test": "pnpm run build && pnpm -r run test",
    "test:unit": "pnpm run build && pnpm -r run test:unit",
    "test:localstack": "pnpm run build && pnpm --filter hardhat-kms-aws run test:localstack",
    "test:live:aws": "pnpm run build && pnpm --filter hardhat-kms-aws run test:live:aws",
    "test:sdk-floors": "node scripts/test-sdk-floors.ts",
    "coverage": "pnpm run build && pnpm -r run coverage",
    "pkg:check": "pnpm run build && node scripts/check-packages.ts && knip",
    "docs:check": "pnpm run build && node scripts/check-docs.ts",
    "prepare": "lefthook install && node scripts/install-git-hooks.ts",
    "changeset": "changeset",
    "release": "pnpm run clean && pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "hardhat": "catalog:",
    "hardhat-kms": "workspace:*",
    "hardhat-kms-aws": "workspace:*",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn"
    }
  }
}
