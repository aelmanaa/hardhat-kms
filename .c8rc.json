{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/type-extensions.ts",
    "src/types.ts",
    "src/internal/signer/types.ts",
    "src/internal/vendor/**",
    "test/**"
  ],
  "reporter": ["text", "lcov"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 95,
  "branches": 95,
  "functions": 95,
  "statements": 95
}
