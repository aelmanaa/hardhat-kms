{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "test/live/*.test.ts"],
      "project": ["scripts/*.ts", "test/live/**/*.ts"],
      "ignoreDependencies": [
        "tsx",
        "publint",
        "@arethetypeswrong/cli",
        "@nomicfoundation/hardhat-ignition",
        "@nomicfoundation/hardhat-ignition-viem",
        "@nomicfoundation/hardhat-ledger"
      ]
    },
    "packages/hardhat-kms": {
      "entry": ["test/**/*.test.ts", "test/fixtures/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignore": ["src/internal/vendor/**"],
      "ignoreDependencies": ["tsx"]
    },
    "examples/*": {
      "entry": ["scripts/*.ts"]
    },
    "examples/ignition": {
      "entry": ["scripts/*.ts", "ignition/modules/*.ts"]
    },
    "packages/hardhat-kms-aws": {
      "entry": ["test/**/*.test.ts", "test/fixtures/*.ts", "test/helpers/*.mjs"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/hardhat-kms-azure": {
      "entry": ["test/**/*.test.ts", "test/fixtures/*.ts", "test/helpers/*.mjs"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/hardhat-kms-gcp": {
      "entry": ["test/**/*.test.ts", "test/fixtures/*.ts", "test/helpers/*.mjs"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    }
  }
}
