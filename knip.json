{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"],
      "ignoreDependencies": ["tsx", "hardhat-kms", "publint", "@arethetypeswrong/cli"]
    },
    "packages/hardhat-kms": {
      "entry": ["test/**/*.test.ts", "test/fixtures/*.ts", "test/helpers/*.mjs"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignore": ["src/internal/vendor/**"],
      "ignoreDependencies": ["tsx"]
    }
  }
}
