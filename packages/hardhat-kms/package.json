{
  "name": "hardhat-kms",
  "version": "0.10.1",
  "description": "Hardhat 3 plugin that signs transactions, messages and typed data with keys held in AWS KMS, Google Cloud KMS or Azure Key Vault; works with viem, ethers, Ignition and a Foundry-style --kms option.",
  "keywords": [
    "hardhat-plugin",
    "hardhat",
    "hardhat3",
    "ethereum",
    "smart-contracts",
    "kms",
    "hsm",
    "cloud-kms",
    "signer",
    "remote-signer",
    "aws-kms",
    "google-cloud-kms",
    "azure-key-vault",
    "viem",
    "ethers",
    "hardhat-ignition",
    "foundry",
    "secp256k1"
  ],
  "homepage": "https://aelmanaa.github.io/hardhat-kms/",
  "bugs": {
    "url": "https://github.com/aelmanaa/hardhat-kms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelmanaa/hardhat-kms.git",
    "directory": "packages/hardhat-kms"
  },
  "license": "MIT",
  "author": {
    "name": "Amine El Manaa",
    "url": "https://github.com/aelmanaa"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./provider-utils": {
      "types": "./dist/src/provider-utils.d.ts",
      "default": "./dist/src/provider-utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/",
    "src/",
    "!**/*.test.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node -e \"for (const p of ['dist','coverage']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node ../../scripts/node-test.ts unit \"test/unit/**/*.test.ts\"",
    "test:integration": "node ../../scripts/node-test.ts integration --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "test:mutation": "stryker run",
    "coverage": "c8 --check-coverage node --test --test-concurrency=1 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\""
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@nomicfoundation/hardhat-errors": "^3.1.0",
    "@nomicfoundation/hardhat-utils": "^4.3.0",
    "@nomicfoundation/hardhat-zod-utils": "^3.0.5",
    "micro-eth-signer": "^0.19.0",
    "micro-packed": "^0.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ignition": "catalog:",
    "@nomicfoundation/hardhat-ignition-viem": "catalog:",
    "@nomicfoundation/hardhat-ledger": "catalog:",
    "@nomicfoundation/hardhat-viem": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/tap-runner": "catalog:",
    "@types/node": "catalog:",
    "c8": "catalog:",
    "fast-check": "catalog:",
    "hardhat": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:"
  },
  "peerDependencies": {
    "hardhat": "^3.18.0",
    "viem": "^2.55.13"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  }
}
