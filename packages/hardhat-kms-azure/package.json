{
  "name": "@hardhat-kms/azure",
  "version": "0.10.1",
  "description": "Azure Key Vault and Managed HSM signer for Hardhat 3 (hardhat-kms provider): keys stay in the vault; signing history from Azure Monitor for Key Vault keys.",
  "keywords": [
    "hardhat-plugin",
    "hardhat",
    "hardhat3",
    "ethereum",
    "smart-contracts",
    "hardhat-kms",
    "kms",
    "signer",
    "azure",
    "azure-key-vault",
    "key-vault",
    "managed-hsm",
    "hsm",
    "azure-monitor",
    "viem",
    "ethers"
  ],
  "homepage": "https://aelmanaa.github.io/hardhat-kms/",
  "bugs": {
    "url": "https://github.com/aelmanaa/hardhat-kms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelmanaa/hardhat-kms.git",
    "directory": "packages/hardhat-kms-azure"
  },
  "license": "MIT",
  "author": {
    "name": "Amine El Manaa",
    "url": "https://github.com/aelmanaa"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/",
    "src/",
    "!**/*.test.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node -e \"for (const p of ['dist','coverage']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node ../../scripts/node-test.ts unit \"test/unit/**/*.test.ts\"",
    "test:integration": "node ../../scripts/node-test.ts integration --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "coverage": "c8 --check-coverage node --test --test-concurrency=1 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:live:azure": "node --test --test-concurrency=1 --test-timeout=300000 \"test/live/**/*.test.ts\""
  },
  "dependencies": {
    "@azure/core-rest-pipeline": "^1.25.0",
    "@azure/identity": "^4.13.3",
    "@azure/keyvault-keys": "^4.10.2"
  },
  "devDependencies": {
    "@azure/logger": "^1.4.0",
    "@noble/curves": "^2.4.0",
    "@types/node": "catalog:",
    "c8": "catalog:",
    "hardhat": "catalog:",
    "hardhat-kms": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "hardhat": "^3.18.0",
    "hardhat-kms": "workspace:*"
  }
}
