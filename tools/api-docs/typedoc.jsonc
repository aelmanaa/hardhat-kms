// TypeDoc options for the API reference in docs/user/reference/api/. Run `pnpm run docs:api`:
// scripts/generate-api-docs.ts passes the entry points (the built `.d.ts` file of each export of
// hardhat-kms and of @hardhat-kms/safe) and the output directory. With two packages, TypeDoc
// documents hardhat-kms's internal PlaceholderName helper without a warning, so it needs no
// `intentionallyNotExported` entry.
{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "./tsconfig.json",
  "plugin": ["typedoc-plugin-markdown"],
  "outputFileStrategy": "modules",
  "readme": "none",
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  // "Defined in" links would print build and node_modules paths.
  "disableSources": true,
  "treatWarningsAsErrors": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "expandObjects": true,
  "expandParameters": true,
  "parametersFormat": "table",
  "sanitizeComments": true,
  // Show `Experimental` where a comment has it, not on every member of an experimental module: the
  // module's own badge and the index page already say it.
  "cascadedModifierTags": [],
}
